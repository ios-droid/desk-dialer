{
  "manifest_version": 3,
  "key": "",
  "name": "Desk Dialer",
  "version": "9.4.0",
  "description": "Dial contacts from your Grandstream desk phone and log answered calls to your own Google Sheet.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://server-mocha-eta-42.vercel.app/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Desk Dialer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "minimum_chrome_version": "114",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
